{
  "manifest_version": 3,
  "name": "Solve & Organize — Competitive Coding Repo Sync",
  "version": "0.1.1",
  "description": "Automatically pushes every accepted LeetCode, HackerRank, GeeksforGeeks, Codeforces, CodeChef, AtCoder, and NeetCode solution into one organised GitHub repo.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "*://*.leetcode.com/*",
    "*://leetcode.com/*",
    "*://*.leetcode.cn/*",
    "*://leetcode.cn/*",
    "*://*.hackerrank.com/*",
    "*://hackerrank.com/*",
    "*://*.geeksforgeeks.org/*",
    "*://geeksforgeeks.org/*",
    "*://*.codeforces.com/*",
    "*://codeforces.com/*",
    "*://*.codechef.com/*",
    "*://codechef.com/*",
    "*://*.atcoder.jp/*",
    "*://atcoder.jp/*",
    "*://*.neetcode.io/*",
    "*://neetcode.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/problems/*",
        "*://leetcode.com/problems/*",
        "*://*.leetcode.cn/problems/*",
        "*://leetcode.cn/problems/*"
      ],
      "js": ["content-scripts/leetcode-inject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.leetcode.com/problems/*",
        "*://leetcode.com/problems/*",
        "*://*.leetcode.cn/problems/*",
        "*://leetcode.cn/problems/*"
      ],
      "js": ["content-scripts/leetcode-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.hackerrank.com/challenges/*",
        "*://hackerrank.com/challenges/*",
        "*://*.hackerrank.com/contests/*/challenges/*",
        "*://hackerrank.com/contests/*/challenges/*"
      ],
      "js": ["content-scripts/hackerrank.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.geeksforgeeks.org/problems/*",
        "*://geeksforgeeks.org/problems/*",
        "*://practice.geeksforgeeks.org/problems/*"
      ],
      "js": ["content-scripts/geeksforgeeks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.codeforces.com/problemset/problem/*",
        "*://codeforces.com/problemset/problem/*",
        "*://*.codeforces.com/contest/*/problem/*",
        "*://codeforces.com/contest/*/problem/*",
        "*://*.codeforces.com/gym/*/problem/*",
        "*://codeforces.com/gym/*/problem/*",
        "*://*.codeforces.com/group/*/contest/*/problem/*",
        "*://codeforces.com/group/*/contest/*/problem/*"
      ],
      "js": ["content-scripts/codeforces.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.codechef.com/problems/*",
        "*://codechef.com/problems/*",
        "*://*.codechef.com/practice/*",
        "*://codechef.com/practice/*",
        "*://*.codechef.com/*/problems/*",
        "*://codechef.com/*/problems/*"
      ],
      "js": ["content-scripts/codechef.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.atcoder.jp/contests/*/tasks/*",
        "*://atcoder.jp/contests/*/tasks/*"
      ],
      "js": ["content-scripts/atcoder.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.neetcode.io/problems/*",
        "*://neetcode.io/problems/*",
        "*://*.neetcode.io/practice/*",
        "*://neetcode.io/practice/*"
      ],
      "js": ["content-scripts/neetcode.js"],
      "run_at": "document_idle"
    }
  ]
}
